          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthData": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "服务名"
          },
          "model": {
            "type": "string",
            "title": "Model",
            "description": "实现分支标识，当前固定 py-demo"
          },
          "mode": {
            "type": "string",
            "title": "Mode",
            "description": "是否真实调用上游，当前固定 real"
          },
          "apiBaseUrl": {
            "type": "string",
            "title": "Apibaseurl",
            "description": "小鹅云开放平台地址"
          },
          "wechatApiBaseUrl": {
            "type": "string",
            "title": "Wechatapibaseurl",
            "description": "微信接口地址"
          },
          "credentials": {
            "additionalProperties": {
              "type": "boolean"
            },
            "type": "object",
            "title": "Credentials",
            "description": "各凭证是否配齐（只回显布尔）"
          },
          "upstreams": {
            "additionalProperties": true,
            "type": "object",
            "title": "Upstreams",
            "description": "当前生效的上游接口路径与被覆盖项"
          },
          "env": {
            "type": "string",
            "title": "Env",
            "description": "环境名（development / test / production）"
          },
          "configFile": {
            "type": "string",
            "title": "Configfile",
            "description": "实际读取的配置文件"
          }
        },
        "type": "object",
        "required": [
          "name",
          "model",
          "mode",
          "apiBaseUrl",
          "wechatApiBaseUrl",
          "credentials",
          "upstreams",
          "env",
          "configFile"
        ],
        "title": "HealthData"
      },
      "LoginData": {
        "properties": {
          "koToken": {
            "type": "string",
            "title": "Kotoken",
            "description": "店铺级登录态 ko_token，跳转时按需携带"
          },
          "userId": {
            "type": "string",
            "title": "Userid",
