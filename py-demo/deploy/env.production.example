# py-demo 生产环境配置模板（真实值不要提交 Git，仓库里 .env.production 已被忽略）
# 用法：复制成 py-demo/.env.production 后填值；也可由 deploy/provision.sh 自动生成。
#
# ① 小鹅云开放平台（自己实现登录所需）
XIAOE_APP_ID=appq6jjgwoo7664
CLIENT_ID=
CLIENT_SECRET=
SDK_APP_ID=
SDK_SECRET=
# 开放平台地址：默认即此值，指向预发/沙箱时才改（键名 XIAOE_API_BASE_URL，旧键 API_BASE_URL 仍兼容）
XIAOE_API_BASE_URL=https://api.xiaoe-tech.com

# ①' 小鹅云接口路径覆盖（可选，不写就用代码里的默认清单）
# 用途：接口版本升级、指向沙箱、临时排查。键名固定，写错会被忽略。
# API_PATH_TOKEN=/token
# API_PATH_USER_REGISTER=/xe.user.register/1.0.0
# API_PATH_SDK_ACCOUNT_LOGIN=/xe.sdk.account.login/1.0.0
# API_PATH_USER_INFO_GET=/xe.user.info.get/1.0.0
# API_PATH_BIND_OR_MERGE_PHONE=/xe.account-platform.uaccount.bind_or_merge_phone/1.0.0
# API_PATH_LOGIN_URL=/xe.login.url/1.0.0

# ② 微信小程序
WECHAT_API_BASE_URL=https://api.weixin.qq.com
WX_APP_ID=wx4d356f6b38a0fa42
WX_APP_SECRET=
# 微信接口路径覆盖（可选）
# WX_PATH_JSCODE2SESSION=/sns/jscode2session
# WX_PATH_STABLE_TOKEN=/cgi-bin/stable_token
# WX_PATH_GET_PHONE_NUMBER=/wxa/business/getuserphonenumber

# ③ 本工程运行参数（生产：只监听回环，公网由 nginx 终结 TLS）
PORT=8090
HOST=127.0.0.1
REQUEST_TIMEOUT_MS=10000

# ===== ④ 接口文档 =====
# /api/openapi.json 里的 servers 地址（Apifox / Postman 导入后拿它当基础地址）；留空则不写 servers
OPENAPI_SERVER_URL=https://xiaoe-demo.david-tech.cn
